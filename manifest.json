{
  "manifest_version": 3,
  "name": "Streak Reminders",
  "version": "1.0.0",
  "description": "New Tab reminders for daily streaks with priority queue and done-for-today logic.",
  "permissions": ["storage", "tabs"],
  "options_page": "options.html",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
